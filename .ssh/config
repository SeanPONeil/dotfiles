NoHostAuthenticationForLocalhost  yes

Host *
  IdentityAgent   "~/.1password/agent.sock"
  IgnoreUnknown   AddKeysToAgent,UseKeychain
  UseKeychain     yes
  AddKeysToAgent  yes

Host unifi
  HostName      unifi
  User          sean
  ForwardAgent  yes

Host synology
  ForwardAgent  yes

Host synology-remote
  ForwardAgent  yes

Host pumpkin
  ForwardAgent  yes

Host nuc
  ForwardAgent  yes
