#!/usr/bin/env zsh

portkill() {
  if [[ -z "$1" ]]; then
    echo "usage: portkill <port>" >&2
    return 1
  fi

  local pids
  pids=$(lsof -t -i:"$1" -sTCP:LISTEN)

  if [[ -z "$pids" ]]; then
    echo "nothing listening on port $1"
    return 1
  fi

  echo "$pids" | xargs kill && echo "killed: ${pids//$'\n'/ }"
}

# Determine size of a file or total size of a directory
fs(){
  if du -b /dev/null > /dev/null 2>&1; then
    local arg=-sbh
  else
    local arg=-sh
  fi
  # shellcheck disable=SC2199
  if [[ -n "$@" ]]; then
    du $arg -- "$@"
  else
    du $arg -- .[^.]* *
  fi
}

